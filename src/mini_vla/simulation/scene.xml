<mujoco>
  <worldbody>
    <light pos="0.3 -0.3 1.0" dir="-0.3 0.3 -1" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <light pos="-0.3 0.4 0.8" dir="0.3 -0.4 -1" diffuse="0.5 0.5 0.5"/>

    <geom name="table" type="plane" size="0.5 0.5 0.02" rgba="0.6 0.6 0.6 1"/>

    <body name="base" pos="0 0 0.02">
      <geom type="cylinder" size="0.045 0.02" rgba="0.25 0.25 0.30 1"/>
      <body name="link1" pos="0 0 0.02">
        <joint name="j1" type="hinge" axis="0 0 1" damping="2"/>
        <geom type="capsule" fromto="0 0 0  0 0 0.12" size="0.018" rgba="0.95 0.55 0.15 1"/>
        <body name="link2" pos="0 0 0.12">
          <joint name="j2" type="hinge" axis="0 1 0" damping="2"/>
          <geom type="capsule" fromto="0 0 0  0 0 0.16" size="0.016" rgba="0.95 0.55 0.15 1"/>
          <body name="link3" pos="0 0 0.16">
            <joint name="j3" type="hinge" axis="0 1 0" damping="2"/>
            <geom type="capsule" fromto="0 0 0  0 0 0.13" size="0.014" rgba="0.95 0.55 0.15 1"/>
            <body name="ee" pos="0 0 0.13">
              <geom type="sphere" size="0.022" rgba="0.10 0.80 0.25 1"/>
              <site name="ee_site" pos="0 0 0" size="0.005"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="block_red" pos="{red_pos}">
      <geom type="box" size="0.035 0.035 0.035" rgba="0.88 0.14 0.14 1"/>
    </body>
    <body name="block_blue" pos="{blue_pos}">
      <geom type="cylinder" size="0.035 0.035" rgba="0.14 0.28 0.88 1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="a1" joint="j1" kp="200"/>
    <position name="a2" joint="j2" kp="200"/>
    <position name="a3" joint="j3" kp="200"/>
  </actuator>
</mujoco>
