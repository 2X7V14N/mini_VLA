# 它是复现一次实验的必要信息（配置、指标、对应的 commit）。
checkpoints/*
!checkpoints/*.json
!checkpoints/v1.3_init.pt
!checkpoints/v1.3_base.pt
!checkpoints/v1.3_ft.pt
!checkpoints/v1.3_final.pt

# --- 编辑器 ---
.vscode/
.idea/
.pytest_cache/

